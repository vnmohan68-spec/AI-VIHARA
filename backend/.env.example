# ══════════════════════════════════════════════════════
#  VIHARA AI — Environment Variables
#  Copy to .env:  cp .env.example .env
#  The app works in offline mode without any key.
#  Add HUGGINGFACE_API_TOKEN to unlock full AI features.
# ══════════════════════════════════════════════════════

# ── APPLICATION ───────────────────────────────────────
DEBUG=false
# Generate with: openssl rand -hex 32
SECRET_KEY=generate-with-openssl-rand-hex-32

# ── DATABASE (Docker sets these automatically) ────────
DATABASE_URL=postgresql+asyncpg://vihara:viharapass@postgres:5432/vihara_db
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333

# ══════════════════════════════════════════════════════
#  AI PROVIDER — HuggingFace Inference API (FREE)
# ══════════════════════════════════════════════════════
# 1. Create a free account at https://huggingface.co
# 2. Go to: https://huggingface.co/settings/tokens
# 3. Create a token with "Read" access (free)
# 4. Paste it below
#
# Free-tier limits (as of 2025):
#   - ~1000 requests/day on Serverless Inference
#   - Access to all public models
#   - No credit card required
#
# Models used automatically:
#   Text: Qwen/Qwen2.5-72B-Instruct (primary)
#         mistralai/Mistral-7B-Instruct-v0.3 (fallback)
#         HuggingFaceH4/zephyr-7b-beta (last resort)
#   Vision: Qwen/Qwen2.5-VL-7B-Instruct (primary)
#           Salesforce/blip-image-captioning-large (caption fallback)
HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── FRONTEND URL (for CORS) ───────────────────────────
# Add your deployed frontend URL here in production
# ALLOWED_ORIGINS=["https://your-app.vercel.app"]

# ══════════════════════════════════════════════════════
#  OPTIONAL SERVICES (app works without these)
# ══════════════════════════════════════════════════════

# ── Cloudinary (image upload/storage) ────────────────
# Sign up free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google Maps (nearby attractions map) ─────────────
GOOGLE_MAPS_API_KEY=

# ── OpenWeather (trip planner weather) ───────────────
OPENWEATHER_API_KEY=

# ── Whisper settings (local voice transcription) ─────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
